<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sheru.assistant</string>
  <!-- Run the PROPER py2app bundle executable (built by packaging/setup_app.py). Because the executable lives
       INSIDE Sheru.app, macOS identifies the process as "Sheru" with the app icon — in permission prompts, the
       mic-in-use indicator, and Activity Monitor — not "python3.12". A LaunchAgent runs it in the Aqua GUI
       session so the menu-bar item lays out; the app demotes itself to Accessory at runtime (no dock icon). -->
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Sheru.app/Contents/MacOS/Sheru</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- Restart if Sheru CRASHES (non-zero exit), but honour a clean Quit from the menu bar (exit 0). -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>WorkingDirectory</key><string>/Users/yash/Projects/Sheru</string>
  <key>StandardOutPath</key><string>/Users/yash/Projects/Sheru/data/sheru.log</string>
  <key>StandardErrorPath</key><string>/Users/yash/Projects/Sheru/data/sheru.log</string>
  <!-- launchd starts with a minimal PATH; add ~/.local/bin (claude), Homebrew, and the system dirs so Sheru can
       shell out to claude / osascript / open / afplay / shortcuts. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/yash/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
